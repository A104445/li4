@model IEnumerable<MontagemPro.Models.Products>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
@if (User.IsInRole("Admin")){
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Imagem</th>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Preco)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    <img src="/Images/produto.png" alt="Carro" style="width:150px; height:150px;" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nome)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Preco)
            </td>
                @if (User.IsInRole("Admin")){
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ProductsId">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.ProductsId">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.ProductsId">Delete</a>

                    </td>
                } else {
                    <td>
                        <a asp-action="Details" asp-route-id="@item.ProductsId">Details</a>


                    </td>
                }
        </tr>
}
    </tbody>
</table>
